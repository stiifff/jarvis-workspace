# ── .dockerignore — qué NO entra al build context (más chico = build más rápido,
#    y NUNCA horneamos secretos/estado local en la imagen) ─────────────────────

# Entorno virtual del host (se reinstala dentro de la imagen; pesa cientos de MB)
venv/
.venv/

# Estado local de la app: DB + WAL, token de acceso, secretos de cuentas de CLI,
# perfil del browser remoto, scrollbacks. NUNCA debe quedar dentro de la imagen
# (es un volumen en runtime). El Dockerfile crea /app/data vacío.
data/
jarvis.db

# Git: no shippeamos la historia a terceros. La app boota igual sin .git
# (el updater queda inerte, que es lo correcto en un deploy por imagen).
.git/
.gitignore
.githooks/

# Secretos / entorno
.env
plotspace/.env
*.env

# Bytecode / caches de Python
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Artefacto per-proyecto + estado de coordinación de agentes (efímero, dev-only)
.workspace/
.jarvis/

# Logs
*.log

# Node (defensivo: no debería haber en el repo)
node_modules/

# Herramientas de análisis/review/IDE y notas de dev (no son parte del producto)
.superpowers/
static_analysis_semgrep_*/
.full-review/
.vscode/
.pytest_cache/
frase.txt
.wb-neon-reference.html

# OS
.DS_Store
Thumbs.db

# Los propios archivos de Docker no hacen falta dentro del context
Dockerfile
docker-compose.yml
.dockerignore
