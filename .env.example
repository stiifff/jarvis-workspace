# ─────────────────────────────────────────────────────────────────────────────
# Jarvis Workspace — variables de entorno (Docker).
#   cp .env.example .env   y editá lo que necesites. NUNCA commitees tu .env.
# DÓNDE VA EL ARCHIVO: el motor lo busca en `plotspace/.env` (el repo) y en
# `<data_dir>/.env` (la app INSTALADA, al lado de jarvis.db — ahí no hay repo).
# Un .env que quedó solo en el checkout de WSL NO lo ve el motor de Windows.
# Todas tienen un default sano: el único que casi siempre vas a querer setear es
# PROYECTOS_DIR (dónde está tu código en el host).
# ─────────────────────────────────────────────────────────────────────────────

# ── PROYECTOS (host → contenedor) ────────────────────────────────────────────
# Ruta ABSOLUTA en tu HOST al directorio que contiene tus proyectos de código.
# Se monta dentro del contenedor en /proyectos. Al crear un proyecto en la UI,
# usá la ruta del CONTENEDOR (ej: /proyectos/mi-app). Lo lee docker-compose.yml.
# Default si lo dejás vacío: ./proyectos (relativo a este repo).
PROYECTOS_DIR=/home/tu-usuario/proyectos

# ── API key de Anthropic (OPCIONAL) ──────────────────────────────────────────
# Solo la usan el ORQUESTADOR (chat de Jarvis) y el WEB BUILDER. Los agentes
# Claude Code/Codex usan SU PROPIA auth (la vinculás por la UI → ⚙ → Cuentas),
# así que el flujo central BYOK NO necesita esta key. Dejala vacía si no vas a
# usar el chat del orquestador ni el Web Builder.
ANTHROPIC_API_KEY=

# ── Dictado por voz (OBLIGATORIO si querés dictar) ───────────────────────────
# El dictado transcribe en Groq (whisper-large-v3-turbo, free tier). SIN esta
# key /api/voice/transcribe contesta 503 y el síntoma NO se ve como "falta una
# variable": el micrófono graba normal y el texto vuelve VACÍO. Se saca gratis
# en https://console.groq.com/keys.
GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3   # más calidad, más lento (default: el turbo)

# ── Flags del swarm (defaults: todos ON) ─────────────────────────────────────
# Poné el valor en "off" para apagar el poller correspondiente.
# WATCHDOG=off   # red de seguridad que rescata TASK_DONE perdidos / pasos colgados
# SENTINEL=off   # cierre estructurado de pasos por archivo (fuente primaria)

# ── Web Builder (generador de páginas IA) ────────────────────────────────────
# WB_OJO=off                       # apaga el pulido visual post-generación (el "Ojo")
# WB_OJO_MODEL=claude-sonnet-4-6   # modelo del crítico visual del Ojo
# WB_GUSTO_MODEL=claude-sonnet-4-6 # modelo que destila los ajustes del usuario

# ── Avanzado (rara vez hace falta) ───────────────────────────────────────────
# JARVIS_ALLOWED_HOSTS=mi-host.local   # hosts/orígenes extra permitidos (CSV)
# JARVIS_MAX_BODY_MB=256               # tope de tamaño de request (uploads/zip)
